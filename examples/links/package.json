{
  "name": "@t00ls-dev/example-links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "vite build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file seeds/local.sql",
    "db:status": "pnpm db:status:local",
    "db:status:dev": "wrangler d1 migrations list DB --remote --env dev",
    "db:status:local": "wrangler d1 migrations list DB --local",
    "dev": "pnpm build && wrangler dev",
    "deploy:dev": "pnpm --workspace-root exec turbo run build --filter=@t00ls-dev/example-links... && cross-env CLOUDFLARE_ENV=dev vite build && wrangler deploy --var \"FOUNDATION_SHA:${FOUNDATION_DEPLOY_SHA:?}\" --tag \"${FOUNDATION_DEPLOY_SHA:?}\"",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node e2e/run.mjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@t00ls-dev/auth": "workspace:*",
    "@t00ls-dev/config": "workspace:*",
    "@t00ls-dev/db": "workspace:*",
    "@t00ls-dev/email": "workspace:*",
    "@t00ls-dev/security": "workspace:*",
    "@t00ls-dev/ui": "workspace:*",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "lucide-react": "1.59.0",
    "qrcode": "1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "@t00ls-dev/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20250906.0",
    "tailwindcss": "^4.1.13",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
