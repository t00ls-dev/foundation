{
  "name": "@t00ls-dev/example-links",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "vite build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm db:migrate:local",
    "db:migrate:dev": "wrangler d1 migrations apply DB --remote --env dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed": "wrangler d1 execute DB --local --file seeds/local.sql",
    "db:status": "pnpm db:status:local",
    "db:status:dev": "wrangler d1 migrations list DB --remote --env dev",
    "db:status:local": "wrangler d1 migrations list DB --local",
    "dev": "pnpm build && wrangler dev",
    "deploy:dev": "pnpm --workspace-root exec turbo run build --filter=@t00ls-dev/example-links... && cross-env CLOUDFLARE_ENV=dev vite build && wrangler deploy",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@t00ls-dev/auth": "workspace:*",
    "@t00ls-dev/config": "workspace:*",
    "@t00ls-dev/db": "workspace:*",
    "@t00ls-dev/email": "workspace:*",
    "@t00ls-dev/security": "workspace:*",
    "@t00ls-dev/ui": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.9",
    "qrcode": "1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@t00ls-dev/typescript-config": "workspace:*",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^22.20.4",
    "@types/qrcode": "1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "miniflare": "^4.20250906.0",
    "tailwindcss": "^4.1.13",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.135.0"
  }
}
