{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "foundation",
  "main": "src/worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Apply the central security policy before returning assets or SPA fallback.
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "basic-d1-local",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "dev": {
      "name": "foundation",
      "vars": {
        "BASE_URL": "https://foundation.t00ls.dev",
        "EMAIL_FROM": "Foundation <foundation@t00ls.dev>",
        // TURNSTILE_SITE_KEY is public: add the real DEV key here before opting in.
        // Provision TURNSTILE_SECRET_KEY separately as a Worker secret.
      },
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "foundation.t00ls.dev",
          "custom_domain": true,
        },
      ],
      "observability": {
        "logs": {
          "enabled": true,
          "head_sampling_rate": 1,
          "invocation_logs": true,
          "persist": true,
        },
        "traces": {
          "enabled": false,
          "head_sampling_rate": 1,
          "persist": true,
        },
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "basic-d1-dev",
          "database_id": "1cd6891e-4d58-4781-8786-fe7f78380483",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
