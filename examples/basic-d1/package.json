{
  "name": "@t00ls-dev/example-basic-d1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "db:migrate:local": "wrangler d1 migrations apply basic-d1-local --local",
    "dev": "pnpm build && wrangler dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env production",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests --exclude e2e/**",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@t00ls-dev/auth": "workspace:*",
    "@t00ls-dev/config": "workspace:*",
    "@t00ls-dev/db": "workspace:*",
    "@t00ls-dev/email": "workspace:*",
    "@t00ls-dev/security": "workspace:*",
    "better-auth": "^1.3.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.8.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.12.3",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.13",
    "@t00ls-dev/typescript-config": "workspace:*",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.4",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.5",
    "wrangler": "^4.35.0"
  }
}
