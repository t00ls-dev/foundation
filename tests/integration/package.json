{
  "name": "@t00ls-dev/integration-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.postgres.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.postgres.config.ts",
    "db:seed": "node --experimental-strip-types postgres/seed.ts",
    "db:status": "node --experimental-strip-types postgres/status.ts",
    "lint": "eslint .",
    "test": "vitest run tenant --reporter=default",
    "test:integration": "vitest run --testTimeout=60000 --reporter=default",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@t00ls-dev/access": "workspace:*",
    "@t00ls-dev/audit": "workspace:*",
    "@t00ls-dev/auth": "workspace:*",
    "@t00ls-dev/db": "workspace:*",
    "@t00ls-dev/tenant": "workspace:*",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "miniflare": "^4.20250906.0",
    "pg": "^8.23.1",
    "testcontainers": "^12.2.1",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@t00ls-dev/typescript-config": "workspace:*",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2"
  }
}
