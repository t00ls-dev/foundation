{
  "name": "@t00ls-dev/foundation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e && pnpm test:workspace && pnpm test:operations && pnpm test:levi:runtime",
    "dev": "pnpm --filter levi dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck",
    "test:levi:runtime": "pnpm --filter levi worker:build && pnpm --filter levi test:integration --runtime-acls && pnpm --filter levi test:worker --runtime-acls && pnpm --filter levi test:e2e --runtime-acls",
    "test:workspace": "node --test .github/scripts/workspace.test.mjs .github/scripts/levi-workspace.test.mjs .github/scripts/levi-cloudflare-read.test.mjs .github/scripts/ci-reporting.test.mjs .github/scripts/ci.test.mjs",
    "test:operations": "node --test .github/scripts/deploy-diagnostics.test.mjs"
  },
  "pnpm": {
    "overrides": {
      "vitest>jsdom": "26.1.0",
      "miniflare>undici": "7.30.1",
      "miniflare>sharp": "0.35.5",
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "better-auth@1.7.10>zod": "4.6.7",
      "@better-auth/core@1.7.10>zod": "4.6.7",
      "archiver-utils@5.0.2>glob": "14.0.3",
      "readdir-glob@1.1.3>minimatch": "11.0.3",
      "eslint@10.13.0>minimatch": "11.0.3",
      "@eslint/config-array@0.23.5>minimatch": "11.0.3",
      "@typescript-eslint/typescript-estree@8.72.0>minimatch": "11.0.3"
    }
  },
  "devDependencies": {
    "@t00ls-dev/eslint-config": "workspace:*",
    "eslint": "^10.13.0",
    "jsdom": "26.1.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  }
}
