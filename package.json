{
  "name": "@t00ls-dev/foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e",
    "dev": "turbo run dev --filter=@t00ls-dev/example-basic-d1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@t00ls-dev/eslint-config": "workspace:*",
    "eslint": "^10.0.1",
    "prettier": "^3.9.8",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
