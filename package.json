{
  "name": "@t00ls-dev/foundation",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm test:e2e && pnpm test:distribution && pnpm test:release && pnpm test:migrations",
    "dev": "turbo run dev --filter=@t00ls-dev/example-links",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:distribution": "pnpm --filter './packages/*' -r build && node tests/distribution.mjs",
    "test:release": "node --test .github/scripts/release.test.mjs",
    "test:migrations": "node --test .github/scripts/migrations.test.mjs .github/scripts/migration-recovery.test.mjs .github/scripts/deploy-summary.test.mjs",
    "test:integration": "turbo run test:integration",
    "typecheck": "turbo run typecheck"
  },
  "pnpm": {
    "overrides": {
      "vitest>jsdom": "26.1.0",
      "miniflare>undici": "7.29.1",
      "miniflare>sharp": "0.35.5",
      "@esbuild-kit/core-utils>esbuild": "0.25.12"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@t00ls-dev/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "jsdom": "26.1.0",
    "npm": "12.2.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.8",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  }
}
