{
  "name": "@t00ls-dev/tenant",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "repository": "https://github.com/t00ls-dev/foundation",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "default": "./dist/d1.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./schema/d1": {
      "types": "./dist/schema/d1.d.ts",
      "default": "./dist/schema/d1.js"
    },
    "./schema/postgres": {
      "types": "./dist/schema/postgres.d.ts",
      "default": "./dist/schema/postgres.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --reporter=default",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
