{
  "name": "@t00ls-dev/audit",
  "version": "0.2.0",
  "type": "module",
  "license": "UNLICENSED",
  "repository": "https://github.com/t00ls-dev/foundation",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./d1": {
      "types": "./dist/d1.d.ts",
      "default": "./dist/d1.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run --reporter=default",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@t00ls-dev/typescript-config": "workspace:*",
    "vitest": "^5.0.1"
  }
}
