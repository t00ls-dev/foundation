{
  "name": "__PROJECT_NAME__",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "vite build",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "pnpm db:migrate:local",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file seeds/local.sql",
    "db:status": "pnpm db:status:local",
    "db:status:local": "wrangler d1 migrations list DB --local",
    "db:status:remote": "wrangler d1 migrations list DB --remote",
    "dev": "vite",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "better-auth": "^1.3.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.12.3",
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.4",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.35.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
