{
  "name": "levi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "tsx tools/dev.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/local.js",
    "lint": "eslint 'src/**/*.ts' 'web/**/*.{ts,tsx}' 'tools/**/*.{ts,mjs}' 'test/**/*.ts' 'e2e/**/*.ts' '*.ts' '*.js' --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "format": "prettier --write src web tools test e2e .github '*.json' '*.jsonc' '*.ts' '*.md' docs",
    "format:check": "prettier --check src web tools test e2e .github '*.json' '*.jsonc' '*.ts' '*.md' docs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx tools/migrate.ts",
    "test": "tsx --test test/administration.test.ts test/abuse.test.ts test/contracts.test.ts test/member-contracts.test.ts test/web.test.ts test/worker-config.test.ts test/worker-harness-diagnostics.test.ts test/deploy.test.ts test/ci-evidence.test.ts test/ci-pipeline.test.ts test/migration-history.test.ts",
    "test:integration": "tsx tools/test-integration.ts",
    "dev:api": "tsx src/local.ts",
    "dev:web": "vite",
    "test:e2e": "tsx tools/test-integration.ts --browser",
    "worker:build": "node -e \"require('node:fs').mkdirSync('.local', { recursive: true })\" && wrangler deploy --dry-run --outdir dist/worker --metafile .local/worker-metafile.json",
    "worker:dev": "wrangler dev --local --log-level none",
    "test:worker": "tsx tools/test-integration.ts --worker",
    "db:migrate:dev": "tsx tools/migrate-dev.ts",
    "deploy:dev": "tsx tools/deploy-dev.ts",
    "db:status:dev": "tsx tools/migrate-dev.ts --status"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@t00ls-dev/access": "workspace:*",
    "@t00ls-dev/audit": "workspace:*",
    "@t00ls-dev/auth": "workspace:*",
    "@t00ls-dev/db": "workspace:*",
    "@t00ls-dev/email": "workspace:*",
    "@t00ls-dev/security": "workspace:*",
    "@t00ls-dev/tenant": "workspace:*",
    "@t00ls-dev/ui": "workspace:*",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cloudflare/workers-types": "5.20261025.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "miniflare": "5.20261006.1-alpha",
    "playwright-core": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "license": "MIT"
}
